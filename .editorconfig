# Editor settings shared by every editor (https://editorconfig.org). Prettier
# reads these too; .prettierrc.js and the lefthook pre-commit hook have the
# final say on formatting.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Prettier's printWidth.
[*.{js,jsx,mjs,cjs,ts,tsx,mts,json,yml,yaml}]
max_line_length = 80

# Trailing double spaces are hard line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false

# Gradle files follow the Android template's 4-space style.
[*.gradle]
indent_size = 4

# Windows batch files need CRLF.
[*.{bat,cmd}]
end_of_line = crlf

# Xcode writes these with tabs.
[*.pbxproj]
indent_style = tab
